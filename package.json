{
  "name": "gridscalr",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Local-first PDF plan viewer with calibration, measurement and layered markup tools.",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:canvas": "node scripts/canvas-regression.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts",
    "bench:history": "node scripts/benchmark-history.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:demo": "node scripts/make-demo-project.mjs",
    "docs:capture": "node scripts/capture-docs.mjs",
    "fixture": "node scripts/make-industrial-fixture.mjs",
    "fixture:legacy": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
