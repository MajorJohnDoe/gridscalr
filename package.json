{
  "name": "gridscalr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first PDF plan viewer with calibration, measurement and layered markup tools.",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
