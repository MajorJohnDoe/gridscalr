{
  "name": "gridscalr",
  "private": true,
  "version": "0.15.0",
  "description": "Local-first PDF plan viewer with calibration, measurement and layered markup tools.",
  "license": "MIT",
  "author": "MajorJohnDoe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MajorJohnDoe/gridscalr.git"
  },
  "homepage": "https://github.com/MajorJohnDoe/gridscalr#readme",
  "bugs": {
    "url": "https://github.com/MajorJohnDoe/gridscalr/issues"
  },
  "keywords": [
    "pdf",
    "measurement",
    "quantity-takeoff",
    "floor-plan",
    "construction",
    "tauri",
    "local-first",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/app-icon.svg --output src-tauri/icons",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:canvas": "node scripts/canvas-regression.mjs",
    "test:count": "node scripts/count-workflow.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts eslint.config.mjs",
    "lint": "eslint src tests vite.config.ts",
    "bench:history": "node scripts/benchmark-history.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:demo": "node scripts/make-demo-project.mjs",
    "docs:capture": "node scripts/capture-docs.mjs",
    "fixture": "node scripts/make-industrial-fixture.mjs",
    "fixture:legacy": "node scripts/make-fixture.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/swe": "^1.0.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
